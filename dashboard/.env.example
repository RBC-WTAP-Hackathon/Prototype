# Copy to .env.local. Everything is optional — with nothing set, the dashboard runs
# on in-memory demo data with a keyword-based sentiment fallback.

# Supabase (Project Settings → API). Service role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — set ONE of these
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Shared secret the Slack bot sends as the x-bot-secret header
BOT_SHARED_SECRET=

# Lets the dashboard DM interns ("Send nudge"). Same xoxb- token as the bot.
SLACK_BOT_TOKEN=
# Used to build "Open in Slack" deep links
NEXT_PUBLIC_SLACK_TEAM_ID=

# Set to false outside the demo to disable /api/simulate
ENABLE_SIMULATE=true
