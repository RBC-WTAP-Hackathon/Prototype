# Required, set your Anthropic API key.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Required for HR alerts (low pulse check-ins and /report submissions).
# HR_ALERT_CHANNEL_ID=YOUR_HR_CHANNEL_ID

# Required for weekly reminder nudges. The bot must be a member of this channel;
# its membership is used as the intern roster.
# ROSTER_CHANNEL_ID=YOUR_ROSTER_CHANNEL_ID

# Optional, when to run the weekly reminder sweep. Defaults to Monday at 9:00.
# REMINDER_WEEKDAY=mon
# REMINDER_HOUR=9
# REMINDER_MINUTE=0

# Sends /checkin and /report submissions to the TalentPulse HR dashboard.
# Leave DASHBOARD_URL unset to run the bot without the dashboard.
# DASHBOARD_URL=http://localhost:3000
# Must match BOT_SHARED_SECRET in dashboard/.env.local (sent as the x-bot-secret header).
# BOT_SHARED_SECRET=YOUR_SHARED_SECRET
